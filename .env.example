# Copy to .env and fill in. Never commit .env.
# Local Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgres://crewquo:crewquo@127.0.0.1:5432/crewquo
# Host port the compose Postgres binds. Change both this and the port in
# DATABASE_URL if a native Postgres already holds 5432 on your machine.
# POSTGRES_HOST_PORT=15432

# API
PORT=4000
NODE_ENV=development

# Auth (§5). Required in production; dev falls back to insecure defaults if unset.
JWT_ACCESS_SECRET=dev-insecure-change-me-access
JWT_REFRESH_SECRET=dev-insecure-change-me-refresh
# Optional overrides (seconds): access token 15m, refresh token 30d.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000

# Previously-current signing secrets, comma-separated. Still accepted when
# verifying a token, never used to sign one — this is what lets a secret be
# rotated without signing every user on the platform out at once
# (docs/operating-model/access.md 10, 14 step 4).
#
# The procedure is publish -> promote -> retire:
#   1. append the new secret to the RETIRED list, deploy   (both keys verify)
#   2. move it to JWT_ACCESS_SECRET, deploy                (new tokens use it)
#   3. once ACCESS_TOKEN_TTL_SECONDS has passed, drop the old value from RETIRED
# Empty is the steady state. A list that never empties is a rotation that never
# finished, and every entry in it is a secret that can still mint a session.
#
# The refresh secret signs no refresh token (those are opaque, and their hash is
# the record) but it does sign password-reset and email-verification links, which
# outlive a deploy — so it gets the same overlap.
JWT_ACCESS_SECRET_RETIRED=dev-insecure-retired-access
JWT_REFRESH_SECRET_RETIRED=

# Salt for the rate limiter's source-address hashes. Its own value because it is
# NOT a signing key and must not rotate with one: every stored hash is only
# meaningful against the salt that made it, so moving this silently resets every
# rate-limit budget. Set it once, to any long random string, and then leave it.
# Unset falls back to JWT_REFRESH_SECRET, which is the pre-rotation behaviour —
# fine until you rotate that secret, at which point the counters go with it.
# AUTH_SOURCE_PEPPER=

# Google sign-in (optional until configured; /v1/auth/google 400s without it)
# GOOGLE_CLIENT_ID=

# Base URL used in password-reset / verify-email links (email delivery arrives Phase 5).
# Also the origin the API accepts browser requests from — see CORS_EXTRA_ORIGINS.
APP_BASE_URL=http://localhost:3000

# Extra browser origins allowed to call the API, comma-separated. APP_BASE_URL is
# always allowed and does not need repeating. Empty is the normal case; a wildcard
# is deliberately not supported (docs/operating-model/access.md 10.4).
# CORS_EXTRA_ORIGINS=https://preview.example.com,https://staging.example.com

# Reverse-proxy hops in front of the API, for req.ip. MUST be set to match the
# deployment: too low and every request looks like it came from the proxy, so one
# source-keyed rate-limit budget is shared by the whole internet; too high and a
# caller can forge a header to escape the budget entirely. Render/Vercel behind a
# single proxy is 1; a direct connection is 0.
TRUST_PROXY_HOPS=0

# Web console (apps/web) — where the browser reaches the API. Baked in at build.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Notification email delivery (Resend). Optional: without both of these the
# notification worker records every email as SKIPPED with that reason rather
# than pretending to send, so a dev environment never looks like a working one.
RESEND_API_KEY=
#
# The `from` address, and the one thing that decides whether anybody but you can
# receive mail. `onboarding@resend.dev` is Resend's shared sender: it needs no
# domain verified, and it can ONLY reach the address that owns the Resend account —
# every other recipient comes back 403, which this adapter classifies as permanent,
# so it dead-letters rather than retrying. Verify a domain at resend.com/domains and
# put an address on it here before expecting a real user to be emailed.
NOTIFICATION_FROM_EMAIL=
