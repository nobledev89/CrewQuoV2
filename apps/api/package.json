{
  "name": "@crewquo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "start:source": "tsx src/index.ts",
    "grant-super-admin": "node --enable-source-maps dist/admin/grant-super-admin.js",
    "grant-super-admin:source": "tsx src/modules/admin/grantSuperAdmin.cli.ts",
    "purge-audit": "node --enable-source-maps dist/jobs/purge-audit.js",
    "purge-audit:source": "tsx src/jobs/auditPurge.cli.ts",
    "purge-auth": "node --enable-source-maps dist/jobs/purge-auth.js",
    "purge-auth:source": "tsx src/jobs/authRetention.cli.ts",
    "work": "node --enable-source-maps dist/jobs/workers.js",
    "work:source": "tsx src/jobs/workers.cli.ts",
    "run-closures": "node --enable-source-maps dist/jobs/closures.js",
    "run-closures:source": "tsx src/jobs/closures.cli.ts",
    "rehearse-restore": "tsx src/recovery/rehearseLocal.cli.ts",
    "launch-check": "node --enable-source-maps dist/operations/launch-check.js",
    "launch-check:source": "tsx src/launch/launchCheck.cli.ts",
    "verify:e2e": "tsx scripts/verify-e2e.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@crewquo/shared": "workspace:*",
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.0.1",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "pg": "^8.13.1",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
